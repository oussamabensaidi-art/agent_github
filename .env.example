# ---- Webhook GitHub ----
GITHUB_WEBHOOK_SECRET=change-me

# ---- Auth GitHub : "app" (cible) ou "token" (dev, PAT d'un compte bot) ----
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
# Clé privée de la GitHub App, montée en secret Docker (jamais commitée)
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# Mode token uniquement :
GITHUB_TOKEN=

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Modèle local ----
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,ollama,host.docker.internal

# ---- Alerte email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_FROM=pr-review-bot@calipso-assurances.fr
ALERT_EMAILS=

# ---- Divers ----
AUDIT_LOG_PATH=/data/audit.jsonl
DRY_RUN=false

# ---- Traçage LangSmith (cloud) : toujours coupé ----
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
