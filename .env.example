# ---- Webhook GitHub ----
GITHUB_WEBHOOK_SECRET=change-me

# ---- Auth GitHub : "app" (cible) ou "token" (dev, PAT d'un compte bot) ----
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
# Clé privée de la GitHub App, montée en secret Docker (jamais commitée)
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# Mode token uniquement :
GITHUB_TOKEN=

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Modèle local ----
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,ollama,host.docker.internal

# ---- Alerte email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_FROM=pr-review-bot@calipso-assurances.fr
ALERT_EMAILS=

# ---- Divers ----
AUDIT_LOG_PATH=/data/audit.jsonl
DRY_RUN=false

# ---- Traçage LangSmith (cloud) : toujours coupé ----
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# ---- Fournisseur du modèle : ollama | qwen3api (API LLM Calipso) ----
LLM_PROVIDER=ollama
QWEN3_API_URL=
QWEN3_ENDPOINT=chat
# Clé fournie par l'équipe infra, jamais commitée
QWEN3_API_KEY=

# ---- v2 : verdict, interrupteur, journal d'événements, interface ----
# Mode pilote : l'IA est consultative (seules les détections déterministes bloquent).
PILOT_MODE=true
# Lots de diff analysés en parallèle.
LLM_CONCURRENCY=3
# Valeur initiale de l'interrupteur de publication (ensuite : depuis l'interface).
PUBLISH_ENABLED=true
# Mot de passe Postgres du journal d'événements (docker compose construit DATABASE_URL).
POSTGRES_PASSWORD=
# Comptes de l'interface : login:role:empreinte, séparés par des virgules (role = admin | lecteur).
# Empreinte : python -m ui.auth   (ou --generate)
UI_USERS=
UI_PUBLIC_URL=http://localhost:8020/ui
# Cookie Secure : true dès que l'interface est servie en HTTPS.
UI_COOKIE_SECURE=false
# Mode démo (faux GitHub uniquement, voir docker-compose.demo.yml).
DEMO_MODE=false

# ---- OpenRouter : banc de test uniquement (code fictif), jamais en production ----
OPENROUTER_MODEL=
OPENROUTER_API_KEY=

QWEN3_CONTEXT_TOKENS=8192
