# Configuration PHPStan de l'agent (celle du dépôt n'est jamais utilisée :
# un phpstan.neon peut déclarer des bootstrapFiles, donc exécuter du PHP).
# Extensions Symfony / Doctrine sans conteneur compilé ni objectManagerLoader :
# ces deux options exigeraient d'exécuter le code de la PR.
includes:
    - /opt/tools/vendor/phpstan/phpstan-symfony/extension.neon
    - /opt/tools/vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    tmpDir: /tmp/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
